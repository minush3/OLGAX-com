# ==============================================================================
# Alternative Multi-stage Dockerfile for React (Vite / Tailwind) Frontend
# Use this Dockerfile if your frontend is built with pure Vite
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build the Vite static assets
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder
WORKDIR /app

# Copy dependency specifications
COPY package.json package-lock.json ./
RUN npm ci

# Copy source code and build production bundle
COPY . .
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Serve static production assets with lightweight Nginx
# ------------------------------------------------------------------------------
FROM nginx:alpine AS runner

# Copy custom Nginx configuration configured for port 3000 & SPA routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy Vite build output (dist directory) to Nginx web root
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose frontend port 3000
EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
